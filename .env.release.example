# .env.release.example · template público para scripts/release/deploy-coolify.mjs
#
# Copiar a .env.release (gitignored) y rellenar los valores reales:
#   cp .env.release.example .env.release
#   chmod 600 .env.release
#   $EDITOR .env.release
#
# Cero secretos reales en este archivo. Nunca commitear .env.release.

# ============================================================================
# Coolify API
# ============================================================================
# Base URL del Coolify del VPS (sin slash final).
COOLIFY_BASE_URL=http://YOUR_COOLIFY_HOST:8000

# Bearer token con permisos de deploy. Generar en Coolify Settings → API.
# El script nunca lo imprime; sólo muestra los primeros 4 chars + longitud.
COOLIFY_API_TOKEN=

# UUID de la aplicación a deployar.
COOLIFY_APP_UUID=YOUR_COOLIFY_APP_UUID

# ============================================================================
# VPS · necesario para A.5 lado 2 (docker inspect del label OCI)
# ============================================================================
# Host SSH (alias de ~/.ssh/config preferido sobre user@ip).
VPS_SSH_HOST=YOUR_SSH_HOST_ALIAS

# Opcional. Si está vacío, usa la config default de ssh (~/.ssh/config).
SSH_KEY_PATH=

# Prefijo del container managed por Coolify para esta app. El script hace
# `docker ps | grep ^<prefix>` para encontrar el container actual.
# Allowlist estricta: solo /^[a-zA-Z0-9_.-]+$/. Cualquier otro char aborta.
CONTAINER_NAME_PREFIX=YOUR_CONTAINER_PREFIX

# ============================================================================
# Verificación A.5 dual · endpoints públicos
# ============================================================================
# /healthz tiene que devolver 200 antes de pasar a A.5.
PUBLIC_HEALTHZ_URL=https://YOUR_PUBLIC_HOST/healthz

# /api/version.buildSha es el lado 1 de A.5 (HTTP).
PUBLIC_VERSION_URL=https://YOUR_PUBLIC_HOST/api/version

# ============================================================================
# Comportamiento del script (opcional · tienen defaults)
# ============================================================================
# Comando para tests pre-push. Salteable con --skip-tests.
TEST_COMMAND=cd backend && npm test

# Coolify deploy poll: cada cuánto consultar status (ms).
POLL_INTERVAL_MS=8000

# Coolify deploy poll: max tiempo antes de abortar (ms).
DEPLOY_TIMEOUT_MS=300000

# Healthcheck: max tiempo esperando /healthz=200 post-deploy (ms).
HEALTHZ_TIMEOUT_MS=120000

# Raíz donde el script crea release-evidence/<RUN_ID>/.
EVIDENCE_ROOT=release-evidence
