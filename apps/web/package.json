{
  "name": "@contan2/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'lint placeholder (eslint-config-next llega en PR siguiente)'",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
