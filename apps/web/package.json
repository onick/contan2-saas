    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
