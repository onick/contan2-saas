# Copiar a .env.e2e (gitignored) y completar. NUNCA commitear valores reales.
# Todo apunta a STAGING. assertStaging() aborta si el host no es *.stg.contan2.com / localhost
# (excepcion: proyecto prod-readonly, que solo hace GET/HEAD y no hace login).

E2E_BASE_URL=https://ccb.stg.contan2.com
E2E_PLATFORM_URL=https://admin.stg.contan2.com
E2E_PROD_URL=https://ccb.contan2.com

# Owner de staging (cuenta existente)
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Cuentas por rol (sembradas con provision/seed-staging.sql); el email es e2e-<rol>@test.local
E2E_ADMIN_PASSWORD=
E2E_OPERATOR_PASSWORD=
E2E_CONSULTA_PASSWORD=
E2E_PUERTA_PASSWORD=
E2E_PROTOCOLO_PASSWORD=
E2E_BIBLIOTECA_PASSWORD=

# Escaner (PIN del tenant en staging)
E2E_SCANNER_PIN=

# Tokens en claro (solo el hash va a la DB). Si faltan, make-seed.mjs los genera y los agrega a .env.e2e.
E2E_RESET_TOKEN=
E2E_INVITE_TOKEN=
E2E_INVITE_EMAIL=e2e-invitado@test.local
E2E_INVITE_PASSWORD=

# Plataforma de staging (opcional; el owner decide si se siembra)
E2E_PLATFORM_EMAIL=
E2E_PLATFORM_PASSWORD=

# Lectura SELECT-only en la DB de staging por SSH (tokens RSVP, etc.). Opcional.
E2E_SSH_HOST=
E2E_SSH_KEY=
E2E_DB_CONTAINER=

# Opcionales
# E2E_WORKERS=2
# E2E_RUN_ID=            (se genera solo)
# E2E_ROLES=owner        (limita los logins del setup; por defecto todos los que tengan credenciales)
