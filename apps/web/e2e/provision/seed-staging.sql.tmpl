--               failed_attempts = 0, locked_until = null, lock_level = 0, updated_at = now();

-- Verificacion (sin PII): una fila por cuenta sembrada + semillas RSVP y test-tenant.
select 'rsvp-seed' as que, count(*) filter (where status = 'pending') as pendientes, count(*) as total
from invitations where activity_id = 'e2e-seed-rsvp-act';
select 'test-tenant' as que, o.slug, o.status, (select count(*) from staff_members s where s.organization_id = o.id and s.deleted_at is null) as staff
from organizations o where o.slug = 'test-tenant' and o.deleted_at is null;

select sm.email, sm.role, sm.status
from staff_members sm
join organizations o on o.id = sm.organization_id and o.slug = 'ccb'
where sm.email like 'e2e-%@test.local' and sm.deleted_at is null
order by sm.email;

commit;
