-- ============================================================================
-- seed-staging.sql · cuentas E2E por rol + tokens conocidos (SOLO STAGING)
-- Generado por make-seed.mjs desde seed-staging.sql.tmpl. NO contiene passwords ni tokens
-- en claro: solo hashes (argon2id params v1 / sha256 como hashToken de @contan2/auth).
--
-- Aplicar (lo hace el orquestador, con OK del owner), contra la DB de STAGING unicamente:
--   ssh ... "docker exec -i <DB_STAGING> psql -U postgres -d postgres -v ON_ERROR_STOP=1" < seed-staging.sql
-- Idempotente: re-ejecutar re-sincroniza hash/rol/estado y limpia lockouts de las cuentas e2e-*.
-- Scope: tenant 'ccb' (+ crea 'test-tenant' si no existe, seccion 6). No toca ninguna otra fila.
-- ============================================================================
begin;

-- Falla ruidosa si no hay tenant ccb (evita insertar con org nula).
do $$
begin
  if not exists (select 1 from organizations where slug = 'ccb') then
    raise exception 'organizations.slug=ccb no existe: abortando seed';
  end if;
end $$;

-- 1) Cuentas de staff por rol ------------------------------------------------
with org as (select id from organizations where slug = 'ccb')
insert into staff_members (organization_id, email, password_hash, full_name, status, role, must_change_password)
select org.id, v.email, v.password_hash, v.full_name, 'active', v.role, false
from org,
     (values
       ('e2e-admin@test.local',      '{{HASH_ADMIN}}',      '[E2E] Admin',      'admin'),
       ('e2e-operator@test.local',   '{{HASH_OPERATOR}}',   '[E2E] Operator',   'operator'),
       ('e2e-consulta@test.local',   '{{HASH_CONSULTA}}',   '[E2E] Consulta',   'consulta'),
       ('e2e-puerta@test.local',     '{{HASH_PUERTA}}',     '[E2E] Puerta',     'puerta'),
       ('e2e-protocolo@test.local',  '{{HASH_PROTOCOLO}}',  '[E2E] Protocolo',  'protocolo'),
       ('e2e-biblioteca@test.local', '{{HASH_BIBLIOTECA}}', '[E2E] Biblioteca', 'biblioteca'),
       -- Cuenta dedicada al flujo de reset (AUTH-10): consumir el token CAMBIA su password, asi que
       -- no se usa e2e-admin (rompería el login de las demas corridas). Password aleatoria descartada.
       ('e2e-reset@test.local',      '{{HASH_RESET_ACCOUNT}}', '[E2E] Reset',    'operator')
     ) as v(email, password_hash, full_name, role)
on conflict (organization_id, email) where deleted_at is null
do update set
  password_hash        = excluded.password_hash,
  full_name            = excluded.full_name,
  role                 = excluded.role,
  status               = 'active',
  must_change_password = false,
  failed_attempts      = 0,
  locked_until         = null,
  lock_level           = 0,
  updated_at           = now();

-- 2) Token de reset conocido (AUTH-09/10) -> e2e-reset@test.local ------------
--    token plano en .env.e2e (E2E_RESET_TOKEN); aqui solo sha256. TTL largo; reusable por re-seed.
insert into staff_password_resets (staff_member_id, token_hash, expires_at, used_at)
select sm.id, '{{RESET_TOKEN_HASH}}', now() + interval '30 days', null
from staff_members sm
join organizations o on o.id = sm.organization_id and o.slug = 'ccb'
where sm.email = 'e2e-reset@test.local' and sm.deleted_at is null
on conflict (token_hash)
do update set used_at = null, expires_at = now() + interval '30 days';

-- 3) Invitacion de staff con token conocido (AUTH-11/12) ---------------------
--    Email e2e-invitado@test.local, rol operator. Aceptarla crea ese staff; para repetir el flujo,
--    ejecutar purge-staging.sql (seccion invitado) o archivar la cuenta y re-sembrar.
-- Re-armado idempotente: si la invitación anterior (mismo token) ya no está pendiente,
-- se elimina para que el INSERT no choque con el UNIQUE de token_hash.
delete from staff_invitations si using organizations org
 where org.slug = 'ccb' and si.organization_id = org.id and si.email = 'e2e-invitado@test.local'
   and si.token_hash = '{{INVITE_TOKEN_HASH}}' and si.status <> 'pending';
with org as (select id from organizations where slug = 'ccb'),
     inviter as (
       select sm.id from staff_members sm, org
       where sm.organization_id = org.id and sm.email = 'e2e-admin@test.local' and sm.deleted_at is null
     )
insert into staff_invitations (organization_id, email, role, full_name, token_hash, invited_by_staff_id, expires_at, status)
select org.id, 'e2e-invitado@test.local', 'operator', '[E2E] Invitado',
       '{{INVITE_TOKEN_HASH}}', (select id from inviter), now() + interval '30 days', 'pending'
from org
where not exists (
  select 1 from staff_members sm
  where sm.organization_id = org.id and sm.email = 'e2e-invitado@test.local' and sm.deleted_at is null
)
on conflict (organization_id, email) where status = 'pending'
do update set token_hash = excluded.token_hash, expires_at = now() + interval '30 days', updated_at = now();

-- 5) RSVP-01 sin SSH (decision 6.20): actividad + 6 invitaciones con token CONOCIDO -----------
--    invitations.token se guarda y valida EN CLARO (routes/public.ts: where token = :token), asi que
--    el SQL lleva el token. Cada token = sha256(E2E_RSVP_TOKEN + ':' + slot) (slot 1..6; lo recalcula
--    e2e/fixtures/rsvp-seed.ts); el E2E_RSVP_TOKEN base NO aparece aqui. Slots: 1-3 = RSVP-01a
--    (webkit-tablet, desktop-1440, mobile-390), 4-6 = RSVP-01b. Idempotente: re-ejecutar deja las
--    invitaciones en 'pending', borra las asistencias de la actividad semilla y reinicia el cupo.
--    Nombres fuera del prefijo "[E2E] " para que purge-staging.sql NO las borre. La actividad es
--    activa y futura (visible en el kiosko: KIO-00 se salta mientras exista, ver kiosko-00-vacio).
with org as (select id from organizations where slug = 'ccb')
insert into activities (id, organization_id, name, type, location, date, end_date, capacity, enrolled_count, status, description)
select 'e2e-seed-rsvp-act', org.id, '[E2E-SEED] RSVP (no tocar)', 'Cine', 'Sala E2E',
       now() + interval '365 days', now() + interval '365 days 2 hours', 1000, 0, 'activa',
       'Actividad semilla del arnes E2E (tokens RSVP conocidos). No borrar.'
from org
on conflict (id) do update set
  organization_id = excluded.organization_id, status = 'activa', capacity = 1000, enrolled_count = 0,
  date = now() + interval '365 days', end_date = now() + interval '365 days 2 hours', updated_at = now();

delete from attendance where activity_id = 'e2e-seed-rsvp-act';

with org as (select id from organizations where slug = 'ccb')
insert into users (id, organization_id, code, first_name, last_name, email, phone, deleted_at)
select 'e2e-seed-rsvp-u' || n, org.id, 'CCB-E2ER0' || n, '[E2E-SEED] RSVP', 'Visitante' || n,
       'e2e-seed+rsvp' || n || '@test.local', null, null
from org, generate_series(1, 6) as n
on conflict (id) do update set deleted_at = null, updated_at = now();

with org as (select id from organizations where slug = 'ccb')
insert into invitations (organization_id, activity_id, user_id, token, status, sent_at, responded_at, expires_at, kind, plus_ones)
select org.id, 'e2e-seed-rsvp-act', 'e2e-seed-rsvp-u' || t.n, t.token, 'pending', now(), null,
       now() + interval '365 days', 'audience', 0
from org,
     (values (1, '{{RSVP_TOKEN_1}}'), (2, '{{RSVP_TOKEN_2}}'), (3, '{{RSVP_TOKEN_3}}'),
             (4, '{{RSVP_TOKEN_4}}'), (5, '{{RSVP_TOKEN_5}}'), (6, '{{RSVP_TOKEN_6}}')) as t(n, token)
on conflict (activity_id, user_id)
do update set token = excluded.token, status = 'pending', responded_at = null,
              expires_at = now() + interval '365 days';

-- 6) Tenant de prueba test-tenant (decision 6.24): AUTH-15 directo y PLT-04 ----------------------
--    slug test-tenant -> host test-tenant.stg.contan2.com. Solo se crea si NO existe (no modifica uno
--    existente). Owner e2e-owner@test-tenant.local con la password de E2E_TEST_TENANT_OWNER_PASSWORD.
insert into organizations (slug, name, status, code_prefix)
select 'test-tenant', '[E2E] Test Tenant', 'active', 'TST'
where not exists (select 1 from organizations where slug = 'test-tenant' and deleted_at is null);

with org as (select id from organizations where slug = 'test-tenant' and deleted_at is null)
insert into staff_members (organization_id, email, password_hash, full_name, status, role, must_change_password)
select org.id, 'e2e-owner@test-tenant.local', '{{HASH_TEST_TENANT_OWNER}}', '[E2E] Owner test-tenant', 'active', 'owner', false
from org
on conflict (organization_id, email) where deleted_at is null
do update set
  password_hash = excluded.password_hash, role = 'owner', status = 'active', must_change_password = false,
  failed_attempts = 0, locked_until = null, lock_level = 0, updated_at = now();

-- 4) Plataforma (admin.stg.contan2.com) -- COMENTADO: decide el owner ---------
--    platform_admins NO es por tenant (cross-tenant). Descomentar solo con OK explicito del owner
--    y si E2E_PLATFORM_PASSWORD estaba definido al generar (si no, {{HASH_PLATFORM}} queda sin sustituir).
