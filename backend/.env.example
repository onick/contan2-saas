# =============================================================================
# contan2-saas · variables de entorno
# Copia este archivo a `.env` y completa los valores.
# Nunca commitear `.env` con valores reales.
# =============================================================================

# ----------------- App -----------------
NODE_ENV=development
PORT=3000

# URL pública donde corre la app (sin trailing slash)
# Dev:  http://localhost:3000
# Prod: https://contan2.com
PUBLIC_URL=http://localhost:3000

# Dominio raíz del SaaS para subdomains (sin protocolo)
# Dev:  localhost
# Prod: contan2.com
ROOT_DOMAIN=localhost

# ----------------- Base de datos -----------------
# memory  → JSON file en backend/data/db.json (legacy, single-tenant)
# postgres → PostgreSQL (recomendado para SaaS multi-tenant)
DB_DRIVER=postgres

# Solo si DB_DRIVER=postgres
DATABASE_URL=postgres://ccb:devpass@127.0.0.1:5432/contan2

# ----------------- Auth & sesiones -----------------
# Secreto para firmar cookies. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=cambiame_genera_uno_de_96_chars_hex

# Tiempo de vida de sesión de org_members (admin/owner): horas
SESSION_TTL_HOURS=720

# Tiempo de vida de sesión de staff (kiosko/scanner): horas
STAFF_SESSION_TTL_HOURS=12

# PIN del staff DEFAULT cuando se crea una nueva org (la org puede cambiarlo después).
# Solo se usa en signup, no para auth runtime.
DEFAULT_STAFF_PIN=2828

# ----------------- Email (Resend) -----------------
# Crear cuenta en https://resend.com → API Keys
RESEND_API_KEY=

# Sender por defecto cuando la org no tiene email_from_addr propio
# Formato: "Nombre <email@dominio.com>"
EMAIL_FROM_FALLBACK=contan2 <noreply@contan2.com>

# Reply-to por defecto. Usable para soporte.
EMAIL_REPLY_TO=hola@contan2.com

# ----------------- Cloudflare (multi-tenant SSL futuro) -----------------
# Token con permission Zone:DNS:Edit pinned a la zona del SaaS
# Solo necesario para Traefik DNS-01 challenge en deploy
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_DOMAIN=contan2.com

# ----------------- Stripe (post-MVP) -----------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ----------------- Observabilidad (opcional) -----------------
# Para reportar errores: https://sentry.io
SENTRY_DSN=

# Para métricas de uso: https://plausible.io
PLAUSIBLE_DOMAIN=
